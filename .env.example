# Supabase
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Firebase / Identity Platform (login Google + MFA SMS)
# Valores em: Firebase Console → Project settings → Your apps → Web
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=unithery.com
VITE_FIREBASE_PROJECT_ID=plataforma-therapy-ai
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=708489350104
VITE_FIREBASE_STORAGE_BUCKET=plataforma-therapy-ai.firebasestorage.app
# Edge Functions / Cloud Run
FIREBASE_PROJECT_ID=plataforma-therapy-ai

# API (for edge functions local testing)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# CORS (legado — Edge Functions usam Access-Control-Allow-Origin: * via _shared/cors.ts)
# ALLOWED_ORIGINS=http://localhost:5173

# AI (do not commit real keys)
OPENAI_API_KEY=sk-your-key-here
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Encryption
ENCRYPTION_KEY=your-encryption-key-here

# Web Push (VAPID) — gere com: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key

# Stripe — página oculta /unithery/teste (NUNCA commitar chaves reais)
# Frontend (.env local):
VITE_STRIPE_TEST_PUBLISHABLE_KEY=pk_test_...
VITE_STRIPE_LIVE_PUBLISHABLE_KEY=pk_live_...
# Paywall produção — redirect para Stripe Checkout (substitui bypass quando true)
VITE_STRIPE_BILLING_ENABLED=false
# Secrets das Edge Functions (supabase secrets set):
# STRIPE_TEST_PAGE_ENABLED=true
# STRIPE_LIVE_CHECKOUT_ENABLED=true
# STRIPE_TEST_SECRET_KEY=sk_test_...
# STRIPE_LIVE_SECRET_KEY=sk_live_...
# STRIPE_LIVE_PRODUCT_INICIAL=prod_Utlu7cfq4TY1lp
# STRIPE_LIVE_PRODUCT_INTERMEDIARIO=prod_Utlv6MsaI79XxC
# STRIPE_APP_ORIGIN=http://localhost:5173
# STRIPE_WEBHOOK_SECRET=whsec_...
# Stripe billing produção (Paywall):
# STRIPE_BILLING_ENABLED=true
# STRIPE_BILLING_MODE=test
# STRIPE_BILLING_WEBHOOK_SECRET=whsec_...
# Secrets das Edge Functions (supabase secrets set):
# VAPID_PUBLIC_KEY=...
# VAPID_PRIVATE_KEY=...
# VAPID_SUBJECT=mailto:contato@sua-clinica.com
# CRON_SECRET=...  (mesmo valor em vault.create_secret(..., 'cron_secret'))

# Amazon SES — e-mails de autenticação (Send Email Hook → auth-send-email)
# Secrets das Edge Functions (supabase secrets set):
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_SES_REGION=us-east-1
# AWS_SES_FROM_EMAIL=contact@unithery.com
# AWS_SES_FROM_NAME=Unithery
# CONTACT_INBOX_EMAILS=contato@unithery.com,contact@unithery.com,synestech.business@gmail.com
# AWS_SES_CONFIGURATION_SET=my-first-configuration-set
# SEND_EMAIL_HOOK_SECRET=v1,whsec_...  (gerado no Dashboard → Auth → Hooks)

# Cloud Run (sessão Firebase/Google)
VITE_GCP_API_URL=https://unithery-api-staging-708489350104.us-central1.run.app
